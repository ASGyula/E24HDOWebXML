<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mozi [
        <!ELEMENT mozi (film*)>
        <!ELEMENT film (cim+, rendezo+, szinesz+)>
        <!ATTLIST film mufaj (akcio | vigjatek | drama | romantikus) #REQUIRED>
        <!ELEMENT cim (#PCDATA)>
        <!ELEMENT rendezo EMPTY>
        <!ATTLIST rendezo id ID #REQUIRED>
        <!ATTLIST rendezo nev CDATA #REQUIRED>
        <!ELEMENT szinesz EMPTY>
        <!ATTLIST szinesz id ID #REQUIRED>
        <!ATTLIST szinesz nev CDATA #IMPLIED>
        ]>

<mozi>
    <film mufaj="akcio">
        <cim>Gigakemény film</cim>
        <rendezo id="rendezo_1" nev="Rendező bácsi"/>
        <szinesz id="szinesz_1" nev="Színésznő"/>
        <szinesz id="szinesz_2" nev="Színészúr"/>
    </film>
</mozi>