<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <xs:element name="hallgato">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="keresztnev" type="xs:string"/>
                <xs:element name="vezeteknev" type="xs:string"/>
                <xs:element name="foglalkozas" type="xs:string"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="oktato">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="keresztnev" type="xs:string"/>
                <xs:element name="vezeteknev" type="xs:string"/>
                <xs:element name="foglalkozas" type="xs:string"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="class">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="hallgato" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="oktato" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>