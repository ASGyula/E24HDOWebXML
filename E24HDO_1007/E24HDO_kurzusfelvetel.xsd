<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:simpleType name="jovahagyasTipus">
        <xs:restriction base="xs:string">
            <xs:enumeration value="igen"/>
            <xs:enumeration value="nem"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="nyelvTipus">
        <xs:restriction base="xs:string">
            <xs:enumeration value="magyar"/>
            <xs:enumeration value="eng"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="kreditTipus">
        <xs:restriction base="xs:integer">
            <xs:minInclusive value="0"/>
            <xs:maxInclusive value="10"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="kurzus">
        <xs:sequence>
            <xs:element name="kurzusnev" type="xs:string"/>
            <xs:element name="kredit" type="kreditTipus"/>
            <xs:element name="hely" type="xs:string"/>
            <xs:element name="idopont" type="xs:string"/>
            <xs:element name="oktato" type="xs:string" minOccurs="0"/>
            <xs:element name="oraado" type="xs:string" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="nyelv" type="nyelvTipus" use="required"/>
        <xs:attribute name="jovahagyas" type="jovahagyasTipus" use="required"/>
    </xs:complexType>

    <xs:complexType name="kurzusok">
        <xs:sequence>
            <xs:element name="kurzus" type="kurzus" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="szulev">
        <xs:restriction base="xs:integer">
            <xs:minInclusive value="1930"/>
            <xs:maxInclusive value="2008"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="szak">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="evf" type="xs:string"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="hallgato">
        <xs:sequence>
            <xs:element name="hnev" type="xs:string"/>
            <xs:element name="szulev" type="szulev"/>
            <xs:element name="szak" type="szak"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="hallgató">
        <xs:sequence>
            <xs:element name="hallgato" type="hallgato" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="E24HDO_kurzusfelvetel">
        <xs:sequence>
            <xs:element name="hallgató" type="hallgató"/>
            <xs:element name="kurzusok" type="kurzusok"/>
        </xs:sequence>

        <xs:attribute name="tanév" type="xs:string"/>
        <xs:attribute name="egyetem" type="xs:string"/>
    </xs:complexType>

    <xs:element name="E24HDO_kurzusfelvetel" type="E24HDO_kurzusfelvetel">
        <xs:key name="kurzusIdKey">
            <xs:selector xpath="kurzusok/kurzus"/>
            <xs:field xpath="@id"/>
        </xs:key>
    </xs:element>


</xs:schema>
